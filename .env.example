# Root .env is read by docker compose only (NOT by the Spring Boot app when you run it
# locally with run-dev.ps1 - that reads backend/.env).
# Copy this file to .env and keep the shared values identical to backend/.env.

# ---- Database (used by every profile) ----
POSTGRES_DB=nersmartlogix
DB_USERNAME=nerapp
DB_PASSWORD=CHANGE_ME

# ---- pgAdmin (docker compose --profile tools) ----
PGADMIN_EMAIL=admin@ner.local
PGADMIN_PASSWORD=CHANGE_ME

# ---- Full stack (docker compose --profile full) ----
SPRING_PROFILE=dev
JWT_SECRET=CHANGE_ME_AT_LEAST_64_RANDOM_CHARACTERS
FRONTEND_ORIGIN=http://localhost:5173
WEATHER_PROVIDER=mock
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
GPS_SIMULATOR_ENABLED=true
SEED_DEMO_DATA=true
SEED_DEMO_PASSWORD=CHANGE_ME
