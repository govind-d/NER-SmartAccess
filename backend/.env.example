# =============================================================
#  NER-SmartLogix-AI  --  backend environment variables
#  Copy this file to  backend/.env  and fill in real values.
#  backend/.env is git-ignored and must NEVER be committed.
# =============================================================

# ---- Database (must match docker-compose.yml) ----
DB_URL=jdbc:postgresql://localhost:5432/nersmartlogix
DB_USERNAME=nerapp
DB_PASSWORD=CHANGE_ME

# ---- JWT (used from Phase 3) ----
# Generate with:  openssl rand -base64 64
JWT_SECRET=CHANGE_ME_AT_LEAST_64_RANDOM_CHARACTERS
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# ---- Weather integration (Phase 5) ----
# mock = no external calls, generated NER-realistic data
WEATHER_PROVIDER=mock
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5

# ---- Routing integration (Phase 7) ----
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
ORS_API_KEY=

# ---- Application ----
FRONTEND_ORIGIN=http://localhost:5173
FILE_STORAGE_PATH=./uploads
GPS_SIMULATOR_ENABLED=false

# ---- Demo seed data (dev profile only) ----
SEED_DEMO_DATA=true
SEED_DEMO_PASSWORD=CHANGE_ME
